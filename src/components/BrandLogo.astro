---
import { withBasePath } from '@utils/paths';

const { class: className, alt = 'Divine Drive Detail', ...rest } = Astro.props;
const src = withBasePath('/logo.svg') ?? '/logo.svg';
---

<img
  {...rest}
  src={src}
  alt={alt}
  class:list={['block max-w-none', className]}
  loading="eager"
  decoding="async"
/>
