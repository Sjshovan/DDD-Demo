---
import PrimaryCTA from '@components/ui/buttons/PrimaryCTA.astro';
import { serviceAreaConfig } from '@data/serviceArea';

const { hub, radiusMiles, zoom, coverageHighlights } = serviceAreaConfig;
const mapQuery = `${hub.city}, ${hub.state}`;
const mapEmbedUrl =
  `https://www.google.com/maps?q=${encodeURIComponent(mapQuery)}&z=${zoom}&output=embed`;
const mapOpenUrl =
  `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(mapQuery)}`;
---

<section
  id="service-area"
  class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full"
>
  <div
    class="overflow-hidden rounded-2xl border border-yellow-100/70 bg-gradient-to-br from-yellow-50/70 via-white to-yellow-50/40 p-6 shadow-sm sm:p-8 lg:p-10 dark:border-neutral-700/60 dark:from-neutral-900 dark:via-neutral-900 dark:to-neutral-800/80"
  >
    <div class="grid gap-8 lg:grid-cols-12 lg:items-center lg:gap-10">
      <div class="lg:col-span-5">
        <p
          class="text-xs font-bold tracking-[0.16em] text-yellow-700 uppercase dark:text-yellow-400"
        >
          Servicing the Pontiac area
        </p>
        <h2
          class="mt-2 text-2xl font-bold text-balance text-neutral-800 sm:text-3xl dark:text-neutral-200"
        >
          Mobile Coverage Centered Around {hub.city}, Michigan
        </h2>
        <p class="mt-3 text-pretty text-neutral-600 dark:text-neutral-400">
          Divine Drive Detail currently operates with a default {radiusMiles}-mile
          service radius from {hub.displayName}, giving families and businesses
          around Oakland County reliable access to premium mobile detailing.
        </p>

        <ul class="mt-5 grid grid-cols-2 gap-2 text-sm text-neutral-700 dark:text-neutral-300">
          {
            coverageHighlights.map(location => (
              <li class="rounded-lg border border-yellow-200/70 bg-white/70 px-3 py-2 dark:border-neutral-700 dark:bg-neutral-900/70">
                {location}
              </li>
            ))
          }
        </ul>

        <div class="mt-6 flex flex-wrap items-center gap-3">
          <PrimaryCTA title="Schedule in This Area" url="/contact" />
          <a
            href={mapOpenUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center rounded-lg border border-neutral-300 px-4 py-3 text-sm font-semibold text-neutral-700 transition duration-300 hover:border-neutral-400 hover:text-neutral-900 dark:border-neutral-700 dark:text-neutral-300 dark:hover:border-neutral-500 dark:hover:text-neutral-100"
          >
            Open Map
          </a>
        </div>
      </div>

      <div class="lg:col-span-7">
        <div class="relative overflow-hidden rounded-xl border border-yellow-200/70 bg-white dark:border-neutral-700 dark:bg-neutral-900">
          <iframe
            title={`Map of ${hub.displayName}`}
            src={mapEmbedUrl}
            class="pointer-events-none h-[340px] w-full border-0 select-none sm:h-[420px]"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>

          <div class="pointer-events-none absolute inset-0">
            <div
              class="absolute top-1/2 left-1/2 h-44 w-44 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-yellow-400/80 bg-yellow-400/10"
            >
            </div>
            <div
              class="absolute top-1/2 left-1/2 h-5 w-5 -translate-x-1/2 -translate-y-1/2 rounded-full bg-orange-500 ring-8 ring-orange-400/25"
            >
            </div>
          </div>

          <div
            class="absolute right-3 bottom-3 rounded-full bg-neutral-900/85 px-3 py-1 text-xs font-semibold text-neutral-100 dark:bg-neutral-100/90 dark:text-neutral-900"
          >
            Approx. {radiusMiles}-mile coverage radius
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
