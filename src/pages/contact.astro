---
// Import the necessary components
import MainLayout from '@/layouts/MainLayout.astro';
import ContactSection from '@components/sections/misc/ContactSection.astro';
import { SITE } from '@data/constants';

const pageTitle: string = `Contact | ${SITE.title}`;
const metaDescription =
  'Ready to schedule detailing service or ask about plans? Reach out to Divine Drive Detail today.';
const ogTitle = 'Schedule Service | Divine Drive Detail';
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': 'https://your-username.github.io/DDD-Demo/contact',
    url: 'https://your-username.github.io/DDD-Demo/contact',
    name: 'Schedule Service | Divine Drive Detail',
    description: 'Schedule detailing service or ask about plans with Divine Drive Detail.',
    isPartOf: {
      '@type': 'WebSite',
      url: 'https://your-username.github.io/DDD-Demo/',
      name: 'Divine Drive Detail',
      description: 'Faith-led automotive detailing with premium care plans and community-first impact.',
    },
    inLanguage: 'en-US',
  }}
>
  <ContactSection />
</MainLayout>
